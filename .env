# Legacy app — points at the local PostgreSQL-backed API (legacy-server).
# iOS simulator & web use localhost. For a physical device (Expo Go), replace
# localhost with your Mac's LAN IP, e.g. http://192.168.1.20:4000.
# Physical phone (Expo Go) must reach the Mac by LAN IP, not localhost.
# If your Mac's IP changes, update this (find it: ipconfig getifaddr en0).
EXPO_PUBLIC_API_URL=https://legacy-api-0dno.onrender.com

# ── Google sign-in (optional) ──
# Fill these to enable the "Continue with Google" button. Create a Firebase
# project, enable Google as a sign-in provider, and add OAuth client ids.
# Also set FIREBASE_PROJECT_ID in ../legacy-server/.env to the same project id.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
