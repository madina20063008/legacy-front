# Legacy — public runtime config. Copy to `.env` and fill in.
# Only EXPO_PUBLIC_* values are bundled into the app. NEVER put secret keys here.
# The app runs on seed/mock data until these are set.

# Supabase project (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI assistant Edge Function URL, e.g.
# https://<project-ref>.functions.supabase.co/ai-assistant
EXPO_PUBLIC_AI_FUNCTION_URL=

# ── Server-side only (DO NOT put in this app / .env) ──
# Set with: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
